{
  "name": "java-principles-ai-review",
  "version": "1.0.0",
  "description": "Sistema de revisión automática de código Java con IA usando Husky",
  "main": "scripts/ia-review-diff.js",
  "scripts": {
    "setup": "node scripts/setup.js",
    "test-review": "node scripts/ia-review-diff.js",
    "add-hook": "npx husky add .husky/pre-push \"node scripts/ia-review-diff.js\"",
    "install-hooks": "npx husky install",
    "annotate": "node scripts/ai-code-annotator.js"
  },
  "keywords": [
    "java",
    "code-review",
    "ai",
    "husky",
    "git-hooks",
    "quality"
  ],
  "author": "Tu Nombre",
  "license": "MIT",
  "devDependencies": {
    "husky": "^9.1.7"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "dotenv": "^17.2.1"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}
